#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create the 5x5 Playfair matrix */
void createMatrix(char key[]) {
    int used[26] = {0};
    int i, j, k = 0;
    char ch;

    // I and J are treated as the same letter
    used['J' - 'A'] = 1;

    // Insert key letters
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    // Insert remaining alphabet letters
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (!used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }
}

/* Find position of a character in the matrix */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt plaintext using Playfair rules */
void encrypt(char text[], char result[]) {
    int i, r1, c1, r2, c2;
    int len = strlen(text);
    int pos = 0;
    char a, b;

    for (i = 0; i < len; i++) {
        if (isalpha(text[i]))
            text[pos++] = toupper(text[i]);
    }
    text[pos] = '\0';

    len = strlen(text);

    // Insert X between repeated letters and make length even
    pos = 0;

    for (i = 0; i < len; i++) {
        a = text[i];

        if (i + 1 < len)
            b = text[i + 1];
        else
            b = 'X';

        if (a == b) {
            result[pos++] = a;
            result[pos++] = 'X';
        } else {
            result[pos++] = a;
            result[pos++] = b;
            i++;
        }
    }

    if (pos % 2 != 0)
        result[pos++] = 'X';

    result[pos] = '\0';

    // Encrypt each pair
    for (i = 0; i < pos; i += 2) {
        findPosition(result[i], &r1, &c1);
        findPosition(result[i + 1], &r2, &c2);

        if (r1 == r2) {
            // Same row: move right
            result[i] = matrix[r1][(c1 + 1) % 5];
            result[i + 1] = matrix[r2][(c2 + 1) % 5];
        }
        else if (c1 == c2) {
            // Same column: move down
            result[i] = matrix[(r1 + 1) % 5][c1];
            result[i + 1] = matrix[(r2 + 1) % 5][c2];
        }
        else {
            // Rectangle rule
            result[i] = matrix[r1][c2];
            result[i + 1] = matrix[r2][c1];
        }
    }

    result[pos] = '\0';
}

int main() {
    char key[50];
    char plaintext[100];
    char ciphertext[100];

    printf("Enter keyword: ");
    scanf("%s", key);

    createMatrix(key);

    printf("\nPlayfair Matrix:\n");
    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++)
            printf("%c ", matrix[i][j]);
        printf("\n");
    }

    printf("\nEnter plaintext: ");
    scanf(" %[^\n]", plaintext);

    encrypt(plaintext, ciphertext);

    printf("Ciphertext: %s\n", ciphertext);

    return 0;
}
