#include <stdio.h>
#include <stdint.h>

/* PC-1: 64-bit key -> 56 bits */
int PC1[56] = {
    57,49,41,33,25,17,9,
    1,58,50,42,34,26,18,
    10,2,59,51,43,35,27,
    19,11,3,60,52,44,36,
    63,55,47,39,31,23,15,
    7,62,54,46,38,30,22,
    14,6,61,53,45,37,29,
    21,13,5,28,20,12,4
};

/*
   PC-2:
   First 24 bits come from C
   Second 24 bits come from D
*/
int PC2[48] = {
    14,17,11,24,1,5,
    3,28,15,6,21,10,
    23,19,12,4,26,8,
    16,7,27,20,13,2,

    41,52,31,37,47,55,
    30,40,51,45,33,48,
    44,49,39,56,34,53,
    46,42,50,36,29,32
};

/* DES left-shift schedule */
int shifts[16] = {
    1, 1, 2, 2,
    2, 2, 2, 2,
    1, 2, 2, 2,
    2, 2, 2, 1
};

/* Generic permutation function */
uint64_t permute(uint64_t input,
                 int table[],
                 int outputBits,
                 int inputBits) {

    uint64_t output = 0;
    int i;

    for (i = 0; i < outputBits; i++) {

        output <<= 1;

        output |=
            (input >> (inputBits - table[i])) & 1;
    }

    return output;
}

/* Circular left shift of a 28-bit value */
uint32_t leftShift28(uint32_t value, int shift) {

    return ((value << shift) |
            (value >> (28 - shift))) & 0x0FFFFFFF;
}

/* Generate all 16 DES subkeys */
void generateSubkeys(uint64_t key,
                     uint64_t subkeys[16]) {

    uint64_t permutedKey;

    uint32_t C, D;

    int i;

    /*
       Step 1:
       Apply PC-1 to remove parity bits.
       64 bits -> 56 bits
    */
    permutedKey =
        permute(key, PC1, 56, 64);

    /*
       Step 2:
       Divide 56-bit result into
       two disjoint 28-bit subsets.
    */
    C = (permutedKey >> 28)
        & 0x0FFFFFFF;

    D = permutedKey
        & 0x0FFFFFFF;

    printf("\nInitial halves:\n");
    printf("C0 = %07X\n", C);
    printf("D0 = %07X\n", D);

    /*
       Step 3:
       Generate C1...C16 and D1...D16.
    */
    for (i = 0; i < 16; i++) {

        C = leftShift28(C, shifts[i]);
        D = leftShift28(D, shifts[i]);

        /*
           Combine C and D.
           PC-2 selects:
           24 bits from C
           24 bits from D
        */
        uint64_t combined =
            ((uint64_t)C << 28) | D;

        subkeys[i] =
            permute(combined,
                    PC2,
                    48,
                    56);

        printf("\nRound %2d\n", i + 1);
        printf("Shift = %d\n", shifts[i]);
        printf("C%d = %07X\n", i + 1, C);
        printf("D%d = %07X\n", i + 1, D);

        printf("K%d = %012llX\n",
               i + 1,
               subkeys[i]);
    }
}

int main() {

    uint64_t key;
    uint64_t subkeys[16];

    int i;

    printf("====================================\n");
    printf("       DES SUBKEY GENERATION\n");
    printf("====================================\n");

    printf("\nEnter 64-bit DES key in hexadecimal: ");
    scanf("%llx", &key);

    generateSubkeys(key, subkeys);

    printf("\n\nAll 16 DES Subkeys:\n");

    for (i = 0; i < 16; i++) {

        printf("K%-2d = %012llX\n",
               i + 1,
               subkeys[i]);
    }

    return 0;
}
