#include <stdio.h>
#include <string.h>

/* S-DES Permutation Tables */
int P10[]  = {3,5,2,7,4,10,1,9,8,6};
int P8[]   = {6,3,7,4,8,5,10,9};
int IP[]   = {2,6,3,1,4,8,5,7};
int IP_INV[]= {4,1,3,5,7,2,8,6};
int EP[]   = {4,1,2,3,2,3,4,1};
int P4[]   = {2,4,3,1};

int S0[4][4] = {
    {1,0,3,2},
    {3,2,1,0},
    {0,2,1,3},
    {3,1,3,2}
};

int S1[4][4] = {
    {0,1,2,3},
    {2,0,1,3},
    {3,0,1,0},
    {2,1,0,3}
};

/* Permutation function */
void permute(char *in, char *out, int *table, int n)
{
    int i;

    for (i = 0; i < n; i++)
        out[i] = in[table[i] - 1];

    out[n] = '\0';
}

/* Left circular shift */
void leftShift(char *str, int n)
{
    char temp[6];
    int i;

    for (i = 0; i < 5; i++)
        temp[i] = str[(i + n) % 5];

    temp[5] = '\0';

    for (i = 0; i < 5; i++)
        str[i] = temp[i];
}

/* Generate S-DES keys */
void generateKeys(char *key, char *K1, char *K2)
{
    char p10[11], left[6], right[6];
    char temp[11];

    permute(key, p10, P10, 10);

    strncpy(left, p10, 5);
    left[5] = '\0';

    strncpy(right, p10 + 5, 5);
    right[5] = '\0';

    /* Generate K1 */
    leftShift(left, 1);
    leftShift(right, 1);

    strcpy(temp, left);
    strcat(temp, right);

    permute(temp, K1, P8, 8);

    /* Generate K2 */
    leftShift(left, 2);
    leftShift(right, 2);

    strcpy(temp, left);
    strcat(temp, right);

    permute(temp, K2, P8, 8);
}

/* XOR two binary strings */
void XOR(char *a, char *b, char *result, int n)
{
    int i;

    for (i = 0; i < n; i++)
        result[i] = (a[i] == b[i]) ? '0' : '1';

    result[n] = '\0';
}

/* S-Box lookup */
void sbox(char *bits, int S[4][4], char *output)
{
    int row, col, value;

    row = (bits[0] - '0') * 2 + (bits[3] - '0');
    col = (bits[1] - '0') * 2 + (bits[2] - '0');

    value = S[row][col];

    output[0] = (value / 2) + '0';
    output[1] = (value % 2) + '0';
    output[2] = '\0';
}

/* F-function */
void fk(char *bits, char *key, char *result)
{
    char left[5], right[5];
    char ep[9], x[9];
    char left4[5], right4[5];
    char s0out[3], s1out[3];
    char sboxout[5], p4[5];
    char xorleft[5];

    strncpy(left, bits, 4);
    left[4] = '\0';

    strncpy(right, bits + 4, 4);
    right[4] = '\0';

    permute(right, ep, EP, 8);

    XOR(ep, key, x, 8);

    strncpy(left4, x, 4);
    left4[4] = '\0';

    strncpy(right4, x + 4, 4);
    right4[4] = '\0';

    sbox(left4, S0, s0out);
    sbox(right4, S1, s1out);

    strcpy(sboxout, s0out);
    strcat(sboxout, s1out);

    permute(sboxout, p4, P4, 4);

    XOR(left, p4, xorleft, 4);

    strcpy(result, xorleft);
    strcat(result, right);
}

/* S-DES encryption */
void SDES_Encrypt(char *plain, char *key, char *cipher)
{
    char K1[9], K2[9];
    char temp[9], swapped[9], result[9];

    generateKeys(key, K1, K2);

    permute(plain, temp, IP, 8);

    fk(temp, K1, result);

    /* Swap halves */
    strncpy(swapped, result + 4, 4);
    swapped[4] = '\0';

    strncat(swapped, result, 4);
    swapped[8] = '\0';

    fk(swapped, K2, result);

    permute(result, cipher, IP_INV, 8);
}

/* S-DES decryption */
void SDES_Decrypt(char *cipher, char *key, char *plain)
{
    char K1[9], K2[9];
    char temp[9], swapped[9], result[9];

    generateKeys(key, K1, K2);

    permute(cipher, temp, IP, 8);

    /* Reverse key order */
    fk(temp, K2, result);

    /* Swap halves */
    strncpy(swapped, result + 4, 4);
    swapped[4] = '\0';

    strncat(swapped, result, 4);
    swapped[8] = '\0';

    fk(swapped, K1, result);

    permute(result, plain, IP_INV, 8);
}

/* CBC Encryption */
void CBC_Encrypt(char *plaintext, char *ciphertext,
                 char *key, char *IV)
{
    char block[9], xorBlock[9];
    char previous[9];
    int i;

    strcpy(previous, IV);

    for (i = 0; i < 16; i += 8)
    {
        strncpy(block, plaintext + i, 8);
        block[8] = '\0';

        /* Plaintext XOR previous ciphertext */
        XOR(block, previous, xorBlock, 8);

        /* S-DES encryption */
        SDES_Encrypt(xorBlock, key, ciphertext + i);

        /* Current ciphertext becomes previous block */
        strncpy(previous, ciphertext + i, 8);
        previous[8] = '\0';
    }

    ciphertext[16] = '\0';
}

/* CBC Decryption */
void CBC_Decrypt(char *ciphertext, char *plaintext,
                 char *key, char *IV)
{
    char block[9], decrypted[9];
    char previous[9];
    char xorResult[9];
    int i;

    strcpy(previous, IV);

    for (i = 0; i < 16; i += 8)
    {
        strncpy(block, ciphertext + i, 8);
        block[8] = '\0';

        /* S-DES decryption */
        SDES_Decrypt(block, key, decrypted);

        /* XOR with previous ciphertext */
        XOR(decrypted, previous, xorResult, 8);

        strncpy(plaintext + i, xorResult, 8);

        /* Current ciphertext becomes previous */
        strcpy(previous, block);
    }

    plaintext[16] = '\0';
}

int main()
{
    char key[]       = "0111111101";
    char IV[]        = "10101010";
    char plaintext[] = "0000000100100011";

    char ciphertext[17];
    char decrypted[17];

    printf("S-DES CBC MODE\n");
    printf("-----------------------------\n");

    printf("Key       : %s\n", key);
    printf("IV        : %s\n", IV);
    printf("Plaintext : %s\n", plaintext);

    /* Encryption */
    CBC_Encrypt(plaintext, ciphertext, key, IV);

    printf("\nEncrypted Ciphertext:\n");
    printf("%c%c%c%c%c%c%c%c ",
           ciphertext[0], ciphertext[1], ciphertext[2], ciphertext[3],
           ciphertext[4], ciphertext[5], ciphertext[6], ciphertext[7]);

    printf("%c%c%c%c%c%c%c%c\n",
           ciphertext[8], ciphertext[9], ciphertext[10], ciphertext[11],
           ciphertext[12], ciphertext[13], ciphertext[14], ciphertext[15]);

    /* Decryption */
    CBC_Decrypt(ciphertext, decrypted, key, IV);

    printf("\nDecrypted Plaintext:\n");
    printf("%c%c%c%c%c%c%c%c ",
           decrypted[0], decrypted[1], decrypted[2], decrypted[3],
           decrypted[4], decrypted[5], decrypted[6], decrypted[7]);

    printf("%c%c%c%c%c%c%c%c\n",
           decrypted[8], decrypted[9], decrypted[10], decrypted[11],
           decrypted[12], decrypted[13], decrypted[14], decrypted[15]);

    return 0;
}
