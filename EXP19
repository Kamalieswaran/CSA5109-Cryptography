/* Generic permutation */
uint64_t permute(uint64_t input,
                 int table[],
                 int n,
                 int inputBits) {

    uint64_t output = 0;
    int i;

    for (i = 0; i < n; i++) {
        output <<= 1;
        output |=
            (input >> (inputBits - table[i])) & 1;
    }

    return output;
}

/*
 * Demonstration DES-like block transformation.
 *
 * For an academic CBC demonstration, this function
 * represents the block encryption operation.
 */
uint64_t des_encrypt(uint64_t block, uint64_t key) {

    /*
     * In a complete DES implementation, this function
     * contains:
     *   1. Initial permutation
     *   2. 16 Feistel rounds
     *   3. S-boxes
     *   4. Final permutation
     *
     * Replace this function with a complete DES
     * implementation or a cryptographic library
     * implementation for real use.
     */

    return block ^ key;
}

/* DES decryption */
uint64_t des_decrypt(uint64_t block, uint64_t key) {
    return block ^ key;
}

/*
 * 3DES Encryption:
 *
 * E(K3, D(K2, E(K1, data)))
 */
uint64_t triple_des_encrypt(uint64_t data,
                            uint64_t K1,
                            uint64_t K2,
                            uint64_t K3) {

    data = des_encrypt(data, K1);

    data = des_decrypt(data, K2);

    data = des_encrypt(data, K3);

    return data;
}

/*
 * Convert 8 bytes to 64-bit integer
 */
uint64_t bytesTo64(unsigned char block[]) {

    uint64_t value = 0;
    int i;

    for (i = 0; i < 8; i++) {
        value = (value << 8) | block[i];
    }

    return value;
}

/*
 * CBC Encryption
 */
void cbc_encrypt(unsigned char plaintext[],
                 unsigned char ciphertext[],
                 int length,
                 uint64_t K1,
                 uint64_t K2,
                 uint64_t K3,
                 uint64_t IV) {

    int i;
    uint64_t block;
    uint64_t encrypted;

    uint64_t previous = IV;

    for (i = 0; i < length; i += BLOCK_SIZE) {

        /*
         * Convert plaintext block to 64 bits
         */
        block = bytesTo64(&plaintext[i]);

        /*
         * CBC:
         *
         * Plaintext XOR previous ciphertext
         */
        block = block ^ previous;

        /*
         * 3DES encryption
         */
        encrypted =
            triple_des_encrypt(
                block,
                K1,
                K2,
                K3
            );

        /*
         * Store ciphertext
         */
        for (int j = 7; j >= 0; j--) {
            ciphertext[i + (7 - j)] =
                (encrypted >> (j * 8)) & 0xFF;
        }

        /*
         * Next block uses current ciphertext
         */
        previous = encrypted;
    }
}

