#include <stdio.h>

/* Extended Euclidean Algorithm */
int extendedGCD(int a, int b, int *x, int *y)
{
    int x1, y1;
    int gcd;

    if (b == 0)
    {
        *x = 1;
        *y = 0;
        return a;
    }

    gcd = extendedGCD(b, a % b, &x1, &y1);

    *x = y1;
    *y = x1 - (a / b) * y1;

    return gcd;
}

/* Modular inverse */
int modInverse(int e, int phi)
{
    int x, y;
    int gcd;

    gcd = extendedGCD(e, phi, &x, &y);

    if (gcd != 1)
        return -1;

    x = x % phi;

    if (x < 0)
        x += phi;

    return x;
}

int main()
{
    int p = 61;
    int q = 53;

    int n;
    int phi;

    int old_e = 17;
    int old_d;

    int new_e = 7;
    int new_d;

    /* Generate modulus */
    n = p * q;

    /* Euler's totient */
    phi = (p - 1) * (q - 1);

    /* Old private key */
    old_d = modInverse(old_e, phi);

    /* New private key using SAME modulus */
    new_d = modInverse(new_e, phi);

    printf("RSA KEY CHANGE DEMONSTRATION\n");
    printf("-----------------------------\n");

    printf("p = %d\n", p);
    printf("q = %d\n", q);
    printf("n = %d\n", n);
    printf("phi(n) = %d\n", phi);

    printf("\nOriginal Keys:\n");
    printf("Public Key  = (%d, %d)\n", old_e, n);
    printf("Private Key = (%d, %d)\n", old_d, n);

    printf("\nNew Keys using SAME modulus:\n");
    printf("Public Key  = (%d, %d)\n", new_e, n);
    printf("Private Key = (%d, %d)\n", new_d, n);

    printf("\nSecurity Result:\n");
    printf("The modulus n is unchanged.\n");
    printf("Therefore, Bob should NOT reuse the same modulus.\n");
    printf("A completely new RSA modulus must be generated.\n");

    return 0;
}
