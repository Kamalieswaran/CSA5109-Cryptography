#include <stdio.h>
#include <string.h>

/* S-DES Tables */
int P10[]     = {3,5,2,7,4,10,1,9,8,6};
int P8[]      = {6,3,7,4,8,5,10,9};
int IP[]      = {2,6,3,1,4,8,5,7};
int IP_INV[]  = {4,1,3,5,7,2,8,6};
int EP[]      = {4,1,2,3,2,3,4,1};
int P4[]      = {2,4,3,1};

int S0[4][4] = {
    {1,0,3,2},
    {3,2,1,0},
    {0,2,1,3},
    {3,1,3,2}
};

int S1[4][4] = {
    {0,1,2,3},
    {2,0,1,3},
    {3,0,1,0},
    {2,1,0,3}
};

/* Permutation */
void permute(char *in, char *out, int *table, int n)
{
    int i;

    for (i = 0; i < n; i++)
        out[i] = in[table[i] - 1];

    out[n] = '\0';
}

/* Left circular shift */
void leftShift(char *str, int n)
{
    char temp[6];
    int i;

    for (i = 0; i < 5; i++)
        temp[i] = str[(i + n) % 5];

    temp[5] = '\0';

    for (i = 0; i < 5; i++)
        str[i] = temp[i];
}

/* Generate S-DES keys */
void generateKeys(char *key, char *K1, char *K2)
{
    char p10[11];
    char left[6], right[6];
    char temp[11];

    permute(key, p10, P10, 10);

    strncpy(left, p10, 5);
    left[5] = '\0';

    strncpy(right, p10 + 5, 5);
    right[5] = '\0';

    /* K1 */
    leftShift(left, 1);
    leftShift(right, 1);

    strcpy(temp, left);
    strcat(temp, right);

    permute(temp, K1, P8, 8);

    /* K2 */
    leftShift(left, 2);
    leftShift(right, 2);

    strcpy(temp, left);
    strcat(temp, right);

    permute(temp, K2, P8, 8);
}

/* XOR */
void XOR(char *a, char *b, char *result, int n)
{
    int i;

    for (i = 0; i < n; i++)
        result[i] = (a[i] == b[i]) ? '0' : '1';

    result[n] = '\0';
}

/* S-Box */
void sbox(char *bits, int S[4][4], char *output)
{
    int row, col, value;

    row = (bits[0] - '0') * 2 + (bits[3] - '0');
    col = (bits[1] - '0') * 2 + (bits[2] - '0');

    value = S[row][col];

    output[0] = (value / 2) + '0';
    output[1] = (value % 2) + '0';
    output[2] = '\0';
}

/* F-function */
void fk(char *bits, char *key, char *result)
{
    char left[5], right[5];
    char ep[9], x[9];
    char left4[5], right4[5];
    char s0out[3], s1out[3];
    char sboxout[5], p4[5];
    char xorleft[5];

    strncpy(left, bits, 4);
    left[4] = '\0';

    strncpy(right, bits + 4, 4);
    right[4] = '\0';

    permute(right, ep, EP, 8);

    XOR(ep, key, x, 8);

    strncpy(left4, x, 4);
    left4[4] = '\0';

    strncpy(right4, x + 4, 4);
    right4[4] = '\0';

    sbox(left4, S0, s0out);
    sbox(right4, S1, s1out);

    strcpy(sboxout, s0out);
    strcat(sboxout, s1out);

    permute(sboxout, p4, P4, 4);

    XOR(left, p4, xorleft, 4);

    strcpy(result, xorleft);
    strcat(result, right);
}

/* S-DES Encryption */
void SDES_Encrypt(char *plain, char *key, char *cipher)
{
    char K1[9], K2[9];
    char temp[9], swapped[9], result[9];

    generateKeys(key, K1, K2);

    permute(plain, temp, IP, 8);

    fk(temp, K1, result);

    /* Swap halves */
    strncpy(swapped, result + 4, 4);
    swapped[4] = '\0';

    strncat(swapped, result, 4);
    swapped[8] = '\0';

    fk(swapped, K2, result);

    permute(result, cipher, IP_INV, 8);
}

/* XOR plaintext with encrypted counter */
void CTR_Process(char *input, char *output,
                 int blocks, char *key)
{
    char counter[9];
    char keystream[9];
    char temp[9];

    int count = 0;
    int i;

    for (i = 0; i < blocks; i++)
    {
        /* Convert counter to 8-bit binary */
        for (int j = 7; j >= 0; j--)
        {
            counter[j] = (count % 2) + '0';
            count /= 2;
        }

        counter[8] = '\0';

        /* Encrypt counter */
        SDES_Encrypt(counter, key, keystream);

        /* XOR input with keystream */
        strncpy(temp, input + (i * 8), 8);
        temp[8] = '\0';

        XOR(temp, keystream, output + (i * 8), 8);

        /* Restore counter for next block */
        count = i + 1;
    }

    output[blocks * 8] = '\0';
}

int main()
{
    char key[] =
        "0111111101";

    char plaintext[] =
        "000000010000001000000100";

    char ciphertext[25];
    char decrypted[25];

    printf("S-DES COUNTER (CTR) MODE\n");
    printf("-----------------------------\n");

    printf("Key       : %s\n", key);
    printf("Counter   : 00000000\n");
    printf("Plaintext : ");

    for (int i = 0; i < 24; i++)
    {
        printf("%c", plaintext[i]);

        if ((i + 1) % 8 == 0)
            printf(" ");
    }

    printf("\n");

    /* Encryption */
    CTR_Process(plaintext, ciphertext, 3, key);

    printf("\nEncrypted Ciphertext:\n");

    for (int i = 0; i < 24; i++)
    {
        printf("%c", ciphertext[i]);

        if ((i + 1) % 8 == 0)
            printf(" ");
    }

    printf("\n");

    /* Decryption */
    CTR_Process(ciphertext, decrypted, 3, key);

    printf("\nDecrypted Plaintext:\n");

    for (int i = 0; i < 24; i++)
    {
        printf("%c", decrypted[i]);

        if ((i + 1) % 8 == 0)
            printf(" ");
    }

    printf("\n");

    return 0;
}
