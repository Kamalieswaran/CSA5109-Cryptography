#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char keyword[50];
    char cipher[26];
    char plaintext[100];
    char ciphertext[100];

    int used[26] = {0};
    int i, j = 0;
    char ch;

    printf("Enter keyword: ");
    scanf("%s", keyword);

    // Generate cipher alphabet using keyword
    for (i = 0; keyword[i] != '\0'; i++) {
        ch = toupper(keyword[i]);

        if (ch >= 'A' && ch <= 'Z' && used[ch - 'A'] == 0) {
            cipher[j++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    // Add remaining unused letters
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (used[ch - 'A'] == 0) {
            cipher[j++] = ch;
            used[ch - 'A'] = 1;
        }
    }

    // Display substitution table
    printf("\nPlain : ");
    for (i = 0; i < 26; i++)
        printf("%c ", 'A' + i);

    printf("\nCipher: ");
    for (i = 0; i < 26; i++)
        printf("%c ", cipher[i]);

    // Input plaintext
    printf("\n\nEnter plaintext: ");
    scanf(" %[^\n]", plaintext);

    // Encryption
    for (i = 0; plaintext[i] != '\0'; i++) {

        if (isalpha(plaintext[i])) {

            int pos = toupper(plaintext[i]) - 'A';

            if (isupper(plaintext[i]))
                ciphertext[i] = cipher[pos];
            else
                ciphertext[i] = tolower(cipher[pos]);

        } else {
            ciphertext[i] = plaintext[i];
        }
    }

    ciphertext[i] = '\0';

    printf("Ciphertext: %s\n", ciphertext);

    return 0;
}
