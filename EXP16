#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

#define MAX 1000
#define ALPHABET 26
#define TOP 10

/* English frequency order */
const char englishOrder[] = "ETAOINSHRDLCUMWFGYPBVKJXQZ";

/* Structure for frequency information */
typedef struct {
    char letter;
    int count;
} LetterFreq;

/* Structure for candidate plaintext */
typedef struct {
    char text[MAX];
    double score;
    char key[27];
} Candidate;

/* Count frequency of letters */
void countFrequency(char text[], int freq[]) {
    int i;

    for (i = 0; i < ALPHABET; i++)
        freq[i] = 0;

    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            freq[toupper(text[i]) - 'A']++;
        }
    }
}

/* Sort letters according to frequency */
void sortFrequency(LetterFreq freq[], int n) {
    int i, j;
    LetterFreq temp;

    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (freq[i].count < freq[j].count) {
                temp = freq[i];
                freq[i] = freq[j];
                freq[j] = temp;
            }
        }
    }
}

/* Decrypt ciphertext using substitution key */
void decrypt(char cipher[], char plain[], char key[]) {
    int i;

    for (i = 0; cipher[i] != '\0'; i++) {

        if (isalpha(cipher[i])) {
            int index = toupper(cipher[i]) - 'A';

            plain[i] = key[index];

            if (islower(cipher[i]))
                plain[i] = tolower(plain[i]);
        }
        else {
            plain[i] = cipher[i];
        }
    }

    plain[i] = '\0';
}

/* Give a score based on common English patterns */
double englishScore(char text[]) {

    const char *common[] = {
        "THE", "AND", "ING", "ION", "TH",
        "HE", "IN", "ER", "AN", "RE",
        "ON", "AT", "EN", "ND", "TI",
        "ES", "OR", "TE", "OF", "ED"
    };

    int i;
    double score = 0;

    for (i = 0; i < 20; i++) {
        char *ptr = text;

        while ((ptr = strstr(ptr, common[i])) != NULL) {
            score += strlen(common[i]);
            ptr++;
        }
    }

    /* Reward common English words */
    if (strstr(text, " THE "))
        score += 20;

    if (strstr(text, " AND "))
        score += 15;

    if (strstr(text, " OF "))
        score += 10;

    if (strstr(text, " TO "))
        score += 10;

    if (strstr(text, " IS "))
        score += 10;

    return score;
}

/* Compare candidates */
int compareCandidates(const void *a, const void *b) {

    Candidate *c1 = (Candidate *)a;
    Candidate *c2 = (Candidate *)b;

    if (c1->score < c2->score)
        return 1;

    if (c1->score > c2->score)
        return -1;

    return 0;
}

/* Generate a candidate key using frequency ordering */
void generateKey(char cipher[], char key[]) {

    int freq[ALPHABET];
    LetterFreq letters[ALPHABET];

    int i;

    countFrequency(cipher, freq);

    /* Store letters and frequencies */
    for (i = 0; i < ALPHABET; i++) {
        letters[i].letter = 'A' + i;
        letters[i].count = freq[i];
    }

    /* Sort according to frequency */
    sortFrequency(letters, ALPHABET);

    /* Map most frequent cipher letters to common English letters */
    for (i = 0; i < ALPHABET; i++) {
        key[letters[i].letter - 'A'] = englishOrder[i];
    }

    key[26] = '\0';
}

int main() {

    char ciphertext[MAX];
    char key[27];
    char plaintext[MAX];

    Candidate candidates[TOP];

    int requested;
    int i;

    printf("============================================\n");
    printf(" Monoalphabetic Substitution Cipher Attack\n");
    printf("============================================\n");

    printf("\nEnter ciphertext:\n");
    fgets(ciphertext, MAX, stdin);

    ciphertext[strcspn(ciphertext, "\n")] = '\0';

    printf("\nHow many possible plaintexts do you want? ");
    scanf("%d", &requested);

    if (requested < 1)
        requested = 1;

    if (requested > TOP)
        requested = TOP;

    /*
       Generate the basic frequency-analysis key.
    */
    generateKey(ciphertext, key);

    /*
       Generate candidates by applying small
       variations to the frequency mapping.
    */

    for (i = 0; i < requested; i++) {

        char tempKey[27];
        int j;

        strcpy(tempKey, key);

        /*
           Swap two plaintext letters to create
           alternative candidates.
        */
        if (i > 0 && i < ALPHABET) {
            char temp;

            temp = tempKey[i - 1];
            tempKey[i - 1] = tempKey[i];
            tempKey[i] = temp;
        }

        decrypt(ciphertext, plaintext, tempKey);

        strcpy(candidates[i].text, plaintext);
        strcpy(candidates[i].key, tempKey);

        candidates[i].score =
            englishScore(plaintext);
    }

    /* Sort candidates */
    qsort(candidates,
          requested,
          sizeof(Candidate),
          compareCandidates);

    printf("\n============================================\n");
    printf("       POSSIBLE PLAINTEXTS\n");
    printf("============================================\n");

    for (i = 0; i < requested; i++) {

        printf("\nRank %d\n", i + 1);

        printf("Score : %.2f\n",
               candidates[i].score);

        printf("Key   : %s\n",
               candidates[i].key);

        printf("Text  : %s\n",
               candidates[i].text);
    }

    return 0;
}
