#include <stdio.h>
#include <math.h>

int main() {
    double log25Fact, log24Fact;

    // log2(n!) = sum of log2(i)
    log25Fact = 0;
    log24Fact = 0;

    for (int i = 1; i <= 25; i++)
        log25Fact += log2(i);

    for (int i = 1; i <= 24; i++)
        log24Fact += log2(i);

    printf("Total possible Playfair keys = 25!\n");
    printf("Approximately = 2^%.2f\n", log25Fact);
    printf("Therefore, approximately = 2^84 keys\n\n");

    printf("Effectively unique keys = 25! / 25 = 24!\n");
    printf("Approximately = 2^%.2f\n", log24Fact);
    printf("Therefore, approximately = 2^79 keys\n");

    return 0;
}
