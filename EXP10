#include <stdio.h>
#include <ctype.h>
#include <string.h>

char matrix[5][5] = {
    {'M', 'F', 'H', 'I', 'K'},
    {'U', 'N', 'O', 'P', 'Q'},
    {'Z', 'V', 'W', 'X', 'Y'},
    {'E', 'L', 'A', 'R', 'G'},
    {'D', 'S', 'T', 'B', 'C'}
};

/* Find the position of a character */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Encrypt two characters */
void encryptPair(char a, char b, char *x, char *y) {
    int r1, c1, r2, c2;

    findPosition(a, &r1, &c1);
    findPosition(b, &r2, &c2);

    if (r1 == r2) {
        // Same row: move right
        *x = matrix[r1][(c1 + 1) % 5];
        *y = matrix[r2][(c2 + 1) % 5];
    }
    else if (c1 == c2) {
        // Same column: move down
        *x = matrix[(r1 + 1) % 5][c1];
        *y = matrix[(r2 + 1) % 5][c2];
    }
    else {
        // Rectangle rule
        *x = matrix[r1][c2];
        *y = matrix[r2][c1];
    }
}

int main() {
    char plaintext[200];
    char prepared[200];
    char ciphertext[200];

    int i, j = 0, len;
    char a, b;

    printf("Enter plaintext:\n");
    fgets(plaintext, sizeof(plaintext), stdin);

    /* Remove spaces and punctuation */
    for (i = 0; plaintext[i] != '\0'; i++) {
        if (isalpha(plaintext[i])) {
            char ch = toupper(plaintext[i]);

            if (ch == 'J')
                ch = 'I';

            prepared[j++] = ch;
        }
    }

    prepared[j] = '\0';

    /* Prepare plaintext into pairs */
    len = strlen(prepared);
    j = 0;

    for (i = 0; i < len; i++) {

        a = prepared[i];

        if (i + 1 < len)
            b = prepared[i + 1];
        else
            b = 'X';

        /* If both letters are same, insert X */
        if (a == b) {
            encryptPair(a, 'X',
                        &ciphertext[j],
                        &ciphertext[j + 1]);
            j += 2;
        }
        else {
            encryptPair(a, b,
                        &ciphertext[j],
                        &ciphertext[j + 1]);
            j += 2;
            i++;
        }
    }

    ciphertext[j] = '\0';

    printf("\nPlayfair Matrix:\n");

    for (i = 0; i < 5; i++) {
        for (int k = 0; k < 5; k++) {
            printf("%c ", matrix[i][k]);
        }
        printf("\n");
    }

    printf("\nCiphertext:\n");

    for (i = 0; ciphertext[i] != '\0'; i++) {
        printf("%c", ciphertext[i]);

        if ((i + 1) % 5 == 4)
            printf(" ");
    }

    printf("\n");

    return 0;
}
