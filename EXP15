#include <stdio.h>
#include <string.h>
#include <ctype.h>
#include <stdlib.h>

#define ALPHABET 26
#define MAX_TEXT 1000

/* Standard English letter frequencies */
double english_freq[26] = {
    8.167, 1.492, 2.782, 4.253, 12.702,
    2.228, 2.015, 6.094, 6.966, 0.153,
    0.772, 4.025, 2.406, 6.749, 7.507,
    1.929, 0.095, 5.987, 6.327, 9.056,
    2.758, 0.978, 2.360, 0.150, 1.974,
    0.074
};

typedef struct {
    int shift;
    double score;
    char plaintext[MAX_TEXT];
} Result;

/* Decrypt using an additive cipher shift */
void decrypt(char ciphertext[], char plaintext[], int shift) {
    int i;

    for (i = 0; ciphertext[i] != '\0'; i++) {

        if (isalpha(ciphertext[i])) {
            char base = isupper(ciphertext[i]) ? 'A' : 'a';

            plaintext[i] =
                (ciphertext[i] - base - shift + 26) % 26 + base;
        }
        else {
            plaintext[i] = ciphertext[i];
        }
    }

    plaintext[i] = '\0';
}

/* Calculate chi-square score */
double chi_square(char text[]) {
    int count[26] = {0};
    int total = 0;
    int i;
    double score = 0.0;

    /* Count letters */
    for (i = 0; text[i] != '\0'; i++) {
        if (isalpha(text[i])) {
            count[tolower(text[i]) - 'a']++;
            total++;
        }
    }

    if (total == 0)
        return 999999.0;

    /*
       Chi-square:
       sum((observed - expected)^2 / expected)
    */
    for (i = 0; i < 26; i++) {
        double expected =
            total * english_freq[i] / 100.0;

        if (expected > 0) {
            score +=
                ((count[i] - expected) *
                 (count[i] - expected)) / expected;
        }
    }

    return score;
}

/* Compare two results for sorting */
int compare(const void *a, const void *b) {
    Result *r1 = (Result *)a;
    Result *r2 = (Result *)b;

    if (r1->score < r2->score)
        return -1;
    else if (r1->score > r2->score)
        return 1;

    return 0;
}

int main() {
    char ciphertext[MAX_TEXT];
    Result results[26];

    int topN;
    int i;

    printf("Enter ciphertext:\n");
    fgets(ciphertext, MAX_TEXT, stdin);

    /* Remove newline */
    ciphertext[strcspn(ciphertext, "\n")] = '\0';

    printf("\nHow many possible plaintexts do you want? ");
    scanf("%d", &topN);

    if (topN < 1)
        topN = 1;

    if (topN > 26)
        topN = 26;

    /* Try all 26 possible shifts */
    for (i = 0; i < 26; i++) {

        results[i].shift = i;

        decrypt(ciphertext,
                results[i].plaintext,
                i);

        results[i].score =
            chi_square(results[i].plaintext);
    }

    /* Sort according to likelihood */
    qsort(results, 26, sizeof(Result), compare);

    printf("\n========================================\n");
    printf("   POSSIBLE PLAINTEXTS\n");
    printf("========================================\n");

    for (i = 0; i < topN; i++) {

        printf("\nRank %d\n", i + 1);
        printf("Shift : %d\n", results[i].shift);
        printf("Score : %.2f\n", results[i].score);
        printf("Text  : %s\n", results[i].plaintext);
    }

    return 0;
}
