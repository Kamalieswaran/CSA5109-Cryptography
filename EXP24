#include <stdio.h>

/* Extended Euclidean Algorithm */
int extended_gcd(int a, int b, int *x, int *y)
{
    int x1, y1, gcd;

    if (b == 0)
    {
        *x = 1;
        *y = 0;
        return a;
    }

    gcd = extended_gcd(b, a % b, &x1, &y1);

    *x = y1;
    *y = x1 - (a / b) * y1;

    return gcd;
}

/* Find prime factors */
void findFactors(int n, int *p, int *q)
{
    int i;

    for (i = 2; i * i <= n; i++)
    {
        if (n % i == 0)
        {
            *p = i;
            *q = n / i;
            return;
        }
    }
}

/* Find private key */
int findPrivateKey(int e, int phi)
{
    int x, y, gcd;
    int d;

    gcd = extended_gcd(e, phi, &x, &y);

    if (gcd != 1)
    {
        return -1;
    }

    d = x % phi;

    if (d < 0)
        d += phi;

    return d;
}

int main()
{
    int e = 31;
    int n = 3599;

    int p, q;
    int phi;
    int d;

    printf("RSA SYSTEM\n");
    printf("-----------------------------\n");

    printf("Public Key:\n");
    printf("e = %d\n", e);
    printf("n = %d\n", n);

    /* Find p and q */
    findFactors(n, &p, &q);

    printf("\nPrime Factors:\n");
    printf("p = %d\n", p);
    printf("q = %d\n", q);

    /* Calculate phi(n) */
    phi = (p - 1) * (q - 1);

    printf("\nPhi(n) = %d\n", phi);

    /* Find private key */
    d = findPrivateKey(e, phi);

    printf("\nPrivate Key:\n");
    printf("d = %d\n", d);
    printf("Private Key = (%d, %d)\n", d, n);

    return 0;
}
