#include <stdio.h>
#include <string.h>
#include <ctype.h>

char matrix[5][5];

/* Create Playfair matrix */
void createMatrix(char key[]) {
    int used[26] = {0};
    int i, j, k = 0;
    char ch;

    // Treat I and J as the same character
    used['J' - 'A'] = 1;

    // Insert key characters
    for (i = 0; key[i] != '\0'; i++) {
        ch = toupper(key[i]);

        if (ch == 'J')
            ch = 'I';

        if (ch >= 'A' && ch <= 'Z' && used[ch - 'A'] == 0) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }

    // Insert remaining alphabet
    for (ch = 'A'; ch <= 'Z'; ch++) {
        if (used[ch - 'A'] == 0) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }
}

/* Find position of a character */
void findPosition(char ch, int *row, int *col) {
    int i, j;

    if (ch == 'J')
        ch = 'I';

    for (i = 0; i < 5; i++) {
        for (j = 0; j < 5; j++) {
            if (matrix[i][j] == ch) {
                *row = i;
                *col = j;
                return;
            }
        }
    }
}

/* Decrypt Playfair ciphertext */
void decrypt(char cipher[], char plain[]) {
    int i;
    int r1, c1, r2, c2;

    for (i = 0; cipher[i] != '\0'; i += 2) {

        findPosition(cipher[i], &r1, &c1);
        findPosition(cipher[i + 1], &r2, &c2);

        if (r1 == r2) {
            // Same row: move left
            plain[i] = matrix[r1][(c1 + 4) % 5];
            plain[i + 1] = matrix[r2][(c2 + 4) % 5];
        }
        else if (c1 == c2) {
            // Same column: move up
            plain[i] = matrix[(r1 + 4) % 5][c1];
            plain[i + 1] = matrix[(r2 + 4) % 5][c2];
        }
        else {
            // Rectangle rule
            plain[i] = matrix[r1][c2];
            plain[i + 1] = matrix[r2][c1];
        }
    }

    plain[i] = '\0';
}

int main() {

    char key[50] = "PT109";

    char cipher[] =
        "KXJEYUREBEZWEHEWRYTUHEYFS"
        "KREHEGOYFIWTTTUOLKSYCAJPO"
        "BOTEIZONTXBYBNTGONEYCUZWR"
        "GDSONSXBOUYWRHEBAAHYUSEDQ";

    char plaintext[200];

    createMatrix(key);

    printf("Playfair Matrix:\n\n");

    for (int i = 0; i < 5; i++) {
        for (int j = 0; j < 5; j++) {
            printf("%c ", matrix[i][j]);
        }
        printf("\n");
    }

    decrypt(cipher, plaintext);

    printf("\nCiphertext:\n%s\n", cipher);

    printf("\nDecrypted Text:\n%s\n", plaintext);

    return 0;
}
